// ---------------------------------------------------------------------------------------------
// Options

interface Options {
  out: string
  full: boolean
  quick: boolean
  db: string | undefined
  /** The parts to write (`--only`); undefined for all of them. */
  only: Set<string> | undefined
}

function options(argv: string[]): Options {
  const value = (flag: string) => {
    const i = argv.indexOf(flag)
    return i >= 0 ? argv[i + 1] : undefined
  }
  return {
    out: resolve(value('--out') ?? join(ROOT, 'crates/csp-sim/fixtures')),
    full: argv.includes('--full'),
    quick: argv.includes('--quick'),
    db: value('--db'),
    only: value('--only') === undefined ? undefined : new Set(value('--only')!.split(',')),
  }
}

/** What to write, by size; `--quick` shrinks everything for the script's own test. */
function plan(o: Options) {
  return o.quick
    ? {
        maps: [
          [1, 64],
          [42, 32],
        ] as [number, number][],
        villageTicks: [0, 1, 60],
        hqTicks: [0, 1],
        sightTicks: [60],
        generated: [128],
        pathMap: [1, 64] as [number, number],
        pathCount: 40,
      }
    : {
        maps: [
          [1, 64],
          [1, 256],
          [1, 512],
          [42, 256],
          [7, 1024],
        ] as [number, number][],
        villageTicks: [0, 1, 60, 1440, 10080],
        hqTicks: [0, 1, 60, 1440, 10080],
        sightTicks: [60, 1440],
        generated: [1024, 2880],
        pathMap: [1, 512] as [number, number],
        pathCount: 200,
      }
}

// ---------------------------------------------------------------------------------------------
// Writing

/** Every file written, with the function that made it, for the README. */
const made: { path: string; by: string }[] = []

let out = ''

function write(path: string, data: string | Uint8Array, by: string): void {
  const file = join(out, path)
  mkdirSync(dirname(file), { recursive: true })
  writeFileSync(file, data)
  made.push({ path, by })
  log(`  ${path}`)
}

/**
 * JSON for the fixtures: as `JSON.stringify`, but numbers JSON can't hold are spelled out, so
 * nothing is lost on the way to Rust: `{"$number": "NaN" | "Infinity" | "-Infinity" | "-0"}`.
 */
function json(value: unknown, space?: number): string {
  return (
    JSON.stringify(
      value,
      (_key, v: unknown) => {
        if (typeof v === 'number' && (!Number.isFinite(v) || Object.is(v, -0)))
          return { $number: Object.is(v, -0) ? '-0' : String(v) }
        return v
      },
      space,
    ) + '\n'
  )
}

const log = (line: string) => process.stdout.write(`${line}\n`)
const base64 = (tiles: Uint8Array) => Buffer.from(tiles).toString('base64')
const sha256 = (data: Uint8Array) => createHash('sha256').update(data).digest('hex')

// ---------------------------------------------------------------------------------------------
// Terrain and nodes

function dumpTerrain(maps: [number, number][]): void {
  log('terrain and nodes')
  for (const [seed, size] of maps) {
    const terrain = generateTerrain(seed, size)
    write(`terrain/${seed}-${size}.bin`, terrain.tiles, `generateTerrain(${seed}, ${size}).tiles`)
    write(
      `nodes/${seed}-${size}.json`,
      json(placeResourceNodes(terrain, seed)),
      `placeResourceNodes(generateTerrain(${seed}, ${size}), ${seed})`,
    )
  }
}

function dumpFullTerrainHash(): void {
  log(`terrain/1-${MAP_SIZE}.sha256 (the full map: this takes a while)`)
  const { tiles } = generateTerrain(1, MAP_SIZE)
  write(
    `terrain/1-${MAP_SIZE}.sha256`,
    `${sha256(tiles)}\n`,
    `sha256 of generateTerrain(1, ${MAP_SIZE}).tiles (--full)`,
  )
}

// ---------------------------------------------------------------------------------------------
// Random numbers and hashes

const STREAM_SEEDS = [1, 7, 31, 2 ** 31 - 1, -5]

function dumpRandom(): void {
  log('random')
  for (const seed of STREAM_SEEDS) {
    const rand = mulberry32(seed)
    write(
      `random/mulberry32-${seed}.json`,
      json({ seed, values: Array.from({ length: 2000 }, rand) }),
      `mulberry32(${seed}), its first 2,000 values`,
    )
  }

  // Lattice points as the terrain uses them, edge cases of the 32-bit arithmetic, and a seeded
  // spread of the rest, 500 in all.
  const edges = [
    0,
    1,
    -1,
    2,
    -2,
    2 ** 31 - 1,
    -(2 ** 31),
    2 ** 31,
    2 ** 32 - 1,
    2 ** 32,
    2 ** 32 + 5,
    2 ** 40 + 3,
    -(2 ** 33) - 7,
    5760,
    5759,
    11,
  ]
  const triples: [number, number, number][] = []
  for (const x of edges)
    for (const y of [0, -1, 2 ** 31 - 1, 2 ** 32 + 5, 11]) triples.push([x, y, (x * 7 + y) % 1000])
  for (const seed of [0, 1, -1, 2 ** 31 - 1, -(2 ** 31), 2 ** 32 + 1, 6])
    triples.push([3, 11, seed])
  const rand = mulberry32(2002)
  const int = (span: number) => Math.floor(rand() * span) - span / 2
  while (triples.length < 500) {
    const span = [100, 12_000, 2 ** 31, 2 ** 34][triples.length % 4]!
    triples.push([int(span), int(span), int(2 ** 20)])
  }
  write(
    'random/hash.json',
    json(triples.map(([x, y, seed]) => ({ x, y, seed, value: latticeHash(x, y, seed) }))),
    'hash(x, y, seed) of terrain-gen.ts, for 500 triples',
  )

  // The FNV-1a string hash seeds names and choices (`givenCityName`, city layouts, Last seen,
  // NPC founding): ids, names, the empty string, and UTF-16 beyond ASCII.
  const texts = [
    '',
    'a',
    'Ashford',
    'Thornbury',
    'city1',
    'city12',
    'r42',
    'res-1-7',
    'Ærøskøbing',
    'Łódź',
    'naïve',
    '日本',
    '🐎 carriage',
    'x'.repeat(300),
  ]
  for (let i = 0; i < 100; i++) texts.push(`city${i}`, `npc${i}:${i * 37}`)
  write(
    'random/name-hash.json',
    json(texts.map((text) => ({ text, value: nameHash(text) }))),
    'hash(text) of residents.ts (FNV-1a), for ids, names and non-ASCII text',
  )
}

// ---------------------------------------------------------------------------------------------
// Stepped and generated worlds

const plains = (size: number): TerrainMap => ({
  size,
  tiles: new Uint8Array(size * size).fill(Terrain.Plains),
})

/** `village()` of `npc-growth.fixture.ts`, rebuilt here: that file imports Vitest. */
function village(): { world: WorldState; terrain: TerrainMap } {
  const FOREST = { x: 34 + 40, y: 34 }
  const terrain = plains(200)
  const world = createWorld(terrain)
  foundNpcCity(world, terrain, NPC_VILLAGE, 20, 20, mulberry32(7))
  world.nodes.push({ id: 'forest', kind: 'forest', ...FOREST })
  terrain.tiles[tileIndex(terrain.size, FOREST.x, FOREST.y)] = Terrain.Forest
  return { world, terrain }
}

/** `hq()` of `trade-org.test.ts`, rebuilt here: the HQ alone on Plains with one node of each kind. */
function hq(): { world: WorldState; terrain: TerrainMap } {
  const MID = 320
  const NODES = [
    ['forest', MID + 80, MID],
    ['stone', MID + 80, MID + 12],
    ['ironOre', MID + 88, MID - 12],
    ['goldOre', MID + 96, MID],
  ] as const
  const terrain = plains(640)
  for (const [kind, x, y] of NODES) {
    terrain.tiles[tileIndex(terrain.size, x, y)] =
      kind === 'forest' ? Terrain.Forest : Terrain.Hills
  }
  const world = createWorld(terrain)
  world.nodes = NODES.map(([kind, x, y], i) => ({ id: `n${i}`, kind, x, y }))
  foundTradeOrgHq(world, terrain, MID, MID, mulberry32(7))
  return { world, terrain }
}

/**
 * `Walking` whose path searches always run to the end within the tick. The game gives them a
 * time budget (`PATH_BUDGET_MS`), which would make where people stand depend on the machine.
 */
class UnhurriedWalking extends Walking {
  override requestSteps(world: WorldState): ReturnType<Walking['requestSteps']> {
    return super.requestSteps(world, Infinity)
  }
}

const worldFile = (world: WorldState, terrain: TerrainMap) =>
  json({ terrain: { size: terrain.size, tiles: base64(terrain.tiles) }, world })

/**
 * What each side of a world sees (`entitiesInSight`), by side: every realm and every city, an NPC
 * city and a Trade Org city seeing for itself as a realm does.
 */
function sightBySide(world: WorldState, terrain: TerrainMap): Record<string, unknown> {
  const sides = [...world.realms.map((r) => r.id), ...world.cities.map((c) => c.id)]
  return Object.fromEntries(sides.map((side) => [side, entitiesInSight(world, terrain, side)]))
}

function dumpStepped(
  name: string,
  setup: () => { world: WorldState; terrain: TerrainMap },
  from: string,
  ticks: number[],
  sightTicks: number[],
  parts: { worlds: boolean; sight: boolean },
): void {
  const wanted = [
    ...new Set([...(parts.worlds ? ticks : []), ...(parts.sight ? sightTicks : [])]),
  ].sort((a, b) => a - b)
  if (wanted.length === 0) return
  log(`worlds/${name}`)
  const { world, terrain } = setup()
  const walking = new UnhurriedWalking(terrain)
  for (const at of wanted) {
    while (world.tick < at) stepWorld(world, terrain, walking)
    const stepped = `${from}, then ${at} × stepWorld(world, terrain, walking) with an unhurried Walking`
    if (parts.worlds && ticks.includes(at)) {
      write(`worlds/${name}-${at}.json`, worldFile(world, terrain), stepped)
    }
    if (parts.sight && sightTicks.includes(at)) {
      write(
        `worlds/${name}-${at}.sight.json`,
        json(sightBySide(world, terrain)),
        `entitiesInSight for every realm and city of ${stepped}`,
      )
    }
  }
}

/**
 * The worlds `sight.test.ts` starts from, on `cityTerrain()`: Player 1's starting city
 * (`worldWithCity`), and two and three Players' far apart. Sight needs only the map's size, so
 * the terrain is left out; what each side sees comes along.
 */
function dumpSightWorlds(): void {
  log('sight')
  const terrain = cityTerrain()
  for (const [name, players] of [
    ['city', 1],
    ['two-realms', 2],
    ['three-realms', 3],
  ] as const) {
    const world = createWorld(terrain)
    for (let u = 1; u <= players; u++) foundStartingCity(world, terrain, u)
    write(
      `sight/${name}.json`,
      json({ size: terrain.size, world, sight: sightBySide(world, terrain) }),
      `createWorld(cityTerrain()) and foundStartingCity for players 1 to ${players}, with entitiesInSight for every realm and city`,
    )
  }
  dumpVisitors()
}

/**
 * Player 1's residents visiting NPC cities and the Trade Org HQ, so what a Player sees of them
 * (prices, hire, horses, warehouse prices, standing) comes up: on Plains, the HQ, two villages and
 * a town with their horses, Player 1's city, and one of their residents on each storage, stable and
 * warehouse of the others, a horse of theirs in the town's stable. The villages hold Player 1 in
 * low standing (one refuses them, one won't sell either), the town in high; an offer stands at
 * their storage.
 */
function dumpVisitors(): void {
  const terrain = plains(640)
  const world = createWorld(terrain)
  const rand = mulberry32(11)
  foundTradeOrgHq(world, terrain, 320, 320, rand)
  const [low, lowest, town] = [
    foundNpcCity(world, terrain, NPC_VILLAGE, 60, 60, rand),
    foundNpcCity(world, terrain, NPC_VILLAGE, 60, 500, rand),
    foundNpcCity(world, terrain, NPC_TOWN, 500, 60, rand),
  ]
  // Their horses stand where their stable goes up; it stands there already, with some Food.
  for (const c of [low, lowest, town]) {
    giveNpcHorses(world, terrain, c)
    const h = world.horses.find((x) => x.cityId === c.id)!
    const [x, y] = [h.x - 1, h.y - 1]
    world.buildings.push({
      id: `${c.id}-stable`,
      kind: 'stable',
      cityId: c.id,
      x,
      y,
      stock: { food: 10 },
    })
  }
  const realm = foundStartingCity(world, terrain, 1)
  world.standings.push(
    { of: low.id, toward: realm.id, value: -30 },
    { of: lowest.id, toward: realm.id, value: -70 },
    { of: town.id, toward: realm.id, value: 40 },
  )
  const visited = world.buildings.filter(
    (b) =>
      world.cities.some((c) => c.id === b.cityId && c.realmId === null) &&
      ['storage', 'stable', 'warehouse'].includes(b.kind),
  )
  const residents = world.residents.filter((r) => r.owner === realm.id)
  visited.forEach((b, i) => {
    const r = residents[1 + (i % (residents.length - 1))]!
    if (i < residents.length - 1) Object.assign(r, { x: b.x, y: b.y, order: null })
  })
  const stable = world.buildings.find((b) => b.cityId === town.id && b.kind === 'stable')!
  const horse = world.horses.find((h) => h.realmId === realm.id)!
  Object.assign(horse, { x: stable.x + 1, y: stable.y })
  const storage = world.buildings.find(
    (b) =>
      b.kind === 'storage' && world.cities.find((c) => c.id === b.cityId)?.realmId === realm.id,
  )!
  world.offers.push({
    id: 'offer1',
    realmId: realm.id,
    storageId: storage.id,
    x: storage.x,
    y: storage.y,
    gives: 'food',
    givesUnits: 2,
    wants: 'coins',
    wantsUnits: 3,
    times: 4,
  })
  write(
    'sight/visitors.json',
    json({ size: terrain.size, world, sight: sightBySide(world, terrain) }),
    'Player 1 visiting NPC cities and the Trade Org HQ on Plains (dumpVisitors), with entitiesInSight for every realm and city',
  )
}

function dumpGenerated(sizes: number[]): void {
  for (const size of sizes) {
    log(`worlds/generated-1-${size}`)
    const terrain = generateTerrain(1, size)
    write(
      `worlds/generated-1-${size}.json`,
      worldFile(generateWorld(terrain, 1), terrain),
      `generateWorld(generateTerrain(1, ${size}), 1)`,
    )
  }
}

// ---------------------------------------------------------------------------------------------
// Paths

/** A realm's city with a wall ring round it, one gate in it, shut. */
function wallRing(terrain: TerrainMap, cx: number, cy: number, r: number): WallMap {
  const world = createWorld(terrain)
  addCity(world, { id: 'c1', realmId: 'r1', x: cx, y: cy })
  let n = 0
  for (let dy = -r; dy <= r; dy++) {
    for (let dx = -r; dx <= r; dx++) {
      if (Math.max(Math.abs(dx), Math.abs(dy)) !== r) continue
      const x = cx + dx
      const y = cy + dy
      if (!isPassableTerrain(terrain.tiles[tileIndex(terrain.size, x, y)]!)) continue
      const gate = dx === r && dy === 0
      const b: Building = { id: `w${n++}`, kind: gate ? 'gate' : 'wall', cityId: 'c1', x, y }
      if (gate) b.closed = true
      world.buildings.push(b)
    }
  }
  return wallMap(world, terrain)
}

function dumpPaths(seed: number, size: number, count: number): void {
  log('paths')
  const terrain = generateTerrain(seed, size)
  const centre = Math.floor(size / 2)
  const ring = Math.max(4, Math.floor(size / 24))
  const walls = wallRing(terrain, centre, centre, ring)
  // A road along one row and one column, wherever the ground lets anyone walk.
  const roads: number[] = []
  for (let i = 0; i < size; i++) {
    for (const t of [
      tileIndex(size, i, Math.floor(size / 3)),
      tileIndex(size, Math.floor(size / 3), i),
    ])
      if (isPassableTerrain(terrain.tiles[t]!) && !roads.includes(t)) roads.push(t)
  }
  roads.sort((a, b) => a - b)

  const finders = new Map<string, PathFinder>()
  const finderFor = (withWalls: boolean, withRoads: boolean) => {
    const key = `${withWalls}/${withRoads}`
    let finder = finders.get(key)
    if (!finder) {
      finder = new PathFinder(terrain)
      if (withWalls) finder.setWalls(walls)
      if (withRoads) finder.setRoads(roads)
      finders.set(key, finder)
    }
    return finder
  }

  const rand = mulberry32(84)
  const tile = () => Math.floor(rand() * size)
  const land = (): [number, number] => {
    for (;;) {
      const p: [number, number] = [tile(), tile()]
      if (isPassableTerrain(terrain.tiles[tileIndex(size, p[0], p[1])]!)) return p
    }
  }
  const water = (): [number, number] => {
    for (let i = 0; i < 10_000; i++) {
      const p: [number, number] = [tile(), tile()]
      if (!isPassableTerrain(terrain.tiles[tileIndex(size, p[0], p[1])]!)) return p
    }
    return land()
  }
  const near = (from: [number, number]): [number, number] => {
    for (;;) {
      const p: [number, number] = [
        (from[0] + Math.floor(rand() * 41) - 20 + size) % size,
        (from[1] + Math.floor(rand() * 41) - 20 + size) % size,
      ]
      if (isPassableTerrain(terrain.tiles[tileIndex(size, p[0], p[1])]!)) return p
    }
  }
  const insideRing = (): [number, number] => {
    const inside = [...walls.inside].sort((a, b) => a - b)
    const t = inside[Math.floor(rand() * inside.length)] ?? tileIndex(size, centre, centre)
    return [t % size, Math.floor(t / size)]
  }

  const requests = []
  for (let i = 0; i < count; i++) {
    const kind = i % 10
    const from = kind === 7 ? insideRing() : land()
    const to =
      kind < 4
        ? near(from)
        : kind === 4
          ? water()
          : kind === 5 || kind === 6
            ? insideRing()
            : land()
    const costs = i % 3 === 2 ? 'carriage' : 'walking'
    const withWalls = i % 2 === 0 || kind === 5 || kind === 6 || kind === 7
    const withRoads = i % 4 < 2
    const opts: PathOptions = {}
    if (i % 5 === 1) opts.realmId = 'r1'
    if (i % 5 === 2) opts.realmId = 'r2'
    if (costs === 'walking' && i % 7 === 3) opts.onWalls = true
    if (i % 11 === 4) opts.near = true
    const result = finderFor(withWalls, withRoads).findPath(
      from,
      to,
      costs === 'walking' ? WALKING_COSTS : CARRIAGE_COSTS,
      opts,
    )
    requests.push({
      id: i,
      from,
      to,
      costs,
      walls: withWalls,
      roads: withRoads,
      options: opts,
      result,
    })
  }

  write(
    'paths/requests.json',
    json({
      terrain: `terrain/${seed}-${size}.bin`,
      size,
      roads,
      walls: {
        tiles: [...walls.tiles].sort(([a], [b]) => a - b).map(([t, w]) => ({ tile: t, ...w })),
        inside: [...walls.inside].sort((a, b) => a - b),
      },
      requests,
    }),
    `PathFinder(generateTerrain(${seed}, ${size})).findPath for ${count} requests, one finder per walls/roads setting`,
  )
}

