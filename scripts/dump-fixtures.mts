  'parse',
  'expr',
  'scriptParams',
  'checkNames',
  'tokenize',
]

function scriptsOf(file: string): string[] {
  const text = readFileSync(join(LANG_DIR, file), 'utf8')
  const source = ts.createSourceFile(file, text, ts.ScriptTarget.Latest, true)
  const found: string[] = []
  const literal = (node: ts.Node): string | undefined => {
    if (ts.isStringLiteral(node) || ts.isNoSubstitutionTemplateLiteral(node)) return node.text
    if (ts.isParenthesizedExpression(node)) return literal(node.expression)
    if (ts.isBinaryExpression(node) && node.operatorToken.kind === ts.SyntaxKind.PlusToken) {
      const a = literal(node.left)
      const b = literal(node.right)
      return a !== undefined && b !== undefined ? a + b : undefined
    }
    if (
      ts.isCallExpression(node) &&
      ts.isPropertyAccessExpression(node.expression) &&
      node.expression.name.text === 'join' &&
      ts.isArrayLiteralExpression(node.expression.expression)
    ) {
      const parts = node.expression.expression.elements.map(literal)
      const sep = node.arguments[0] ? literal(node.arguments[0]) : ','
      if (sep === undefined || parts.some((p) => p === undefined)) return undefined
      return parts.join(sep)
    }
    return undefined
  }
  const visit = (node: ts.Node) => {
    if (
      ts.isCallExpression(node) &&
      ts.isIdentifier(node.expression) &&
      HELPERS.includes(node.expression.text)
    ) {
      const arg = node.arguments[0] && literal(node.arguments[0])
      if (arg !== undefined) found.push(node.expression.text === 'value' ? `out(${arg})` : arg)
    }
    ts.forEachChild(node, visit)
  }
  visit(source)
  return found
}

/** Values a script printed, as JSON: functions by their name. */
function printable(value: Value): unknown {
  if (value instanceof ScriptFunction) return { $function: value.name }
  if (value instanceof NativeFunction) return { $native: value.name }
  if (Array.isArray(value)) return value.map(printable)
  if (value && typeof value === 'object')
    return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, printable(v)]))
  return value
}

function syntaxError(error: unknown) {
  if (error instanceof ScriptSyntaxError)
    return { error: { message: error.message, line: error.line, column: error.column } }
  throw error
}

function langCase(
  source: string,
  from: string,
  env: string,
  checkEnv: CheckEnv,
  runnable: boolean,
) {
  let tokens
  try {
    tokens = { tokens: tokenize(source) }
  } catch (error) {
    tokens = syntaxError(error)
  }
  let program
  let ast
  try {
    program = parse(source)
    ast = { program }
  } catch (error) {
    ast = syntaxError(error)
  }
  const names = checkNames(source, checkEnv)
  const c: Record<string, unknown> = {
    from,
    source,
    ...tokens,
    ...ast,
    syntax: checkScript(source),
    env,
    warnings: names.warnings,
    reads: names.reads,
  }
  if (runnable && program) {
    const printed: unknown[] = []
    const out = new NativeFunction('out', (args) => {
      printed.push(printable(args[0] ?? null))
      return null
    })
    const result = run(program, {
      steps: BUDGET,
      maxCallDepth: CALL_DEPTH,
      limits: LIMITS,
      globals: { out },
    })
    c.run = { result, printed }
  }
  return c
}

function dumpLang(): void {
  log('lang')
  const gameEnv = (defaultScript: boolean) => {
    const env = scriptCheckEnv({ defaultScript })
    return {
      ...env,
      describeShape: undefined,
      describedShapes: Object.fromEntries(
        Object.keys(env.shapes).map((s) => [s, env.describeShape(s)]),
      ),
    }
  }
  const envs: Record<string, CheckEnv> = {
    toy: TOY_ENV,
    out: OUT_ENV,
    defaultScript: scriptCheckEnv({ defaultScript: true }),
  }
  const cases = []
  const seen = new Set<string>()
  const files = readdirSync(LANG_DIR)
    .filter((f) => f.endsWith('.test.ts'))
    .sort()
  for (const file of files) {
    const env = file === 'checker.test.ts' ? 'toy' : 'out'
    for (const source of scriptsOf(file)) {
      if (seen.has(source)) continue
      seen.add(source)
      cases.push(langCase(source, `packages/lang/src/${file}`, env, envs[env]!, true))
    }
  }
  for (const [task, script] of Object.entries(DEFAULT_SCRIPTS).sort(([a], [b]) =>
    a.localeCompare(b),
  )) {
    cases.push(
      langCase(
        script.source,
        `DEFAULT_SCRIPTS.${task}`,
        'defaultScript',
        envs.defaultScript!,
        false,
      ),
    )
  }
  write(
    'lang/cases.json',
    json({
      budget: { steps: BUDGET, maxCallDepth: CALL_DEPTH, limits: LIMITS, globals: ['out'] },
      envs: { toy: TOY_ENV, out: OUT_ENV, defaultScript: gameEnv(true) },
      cases,
    }),
    'tokenize, parse, checkScript, checkNames and run for every script in the lang tests and DEFAULT_SCRIPTS',
  )
}

// ---------------------------------------------------------------------------------------------
// Saves and balance

async function dumpSave(db: string | undefined): Promise<void> {
  log('save')
  if (db) {
    // Opened on a copy: loading may migrate the database, and a server may be running on it.
    const scratch = mkdtempSync(join(tmpdir(), 'csp-fixtures-'))
    try {
      for (const suffix of ['', '-wal', '-shm'])
        if (existsSync(db + suffix)) copyFileSync(db + suffix, join(scratch, `world.db${suffix}`))
      const { sqlite, db: drizzle } = await openDb(join(scratch, 'world.db'))
      const row = sqlite
        .prepare('select tick, version from world_saves order by id desc limit 1')
        .get() as { tick: number; version: number } | undefined
      const { world } = loadOrCreateWorld(drizzle, (seed) => generateTerrain(seed))
      sqlite.close()
      // What the server writes as its next save of this world (`saveWorld`).
      write(
        'save/live.json.gz',
        gzipSync(JSON.stringify(world)),
        'loadOrCreateWorld(db) then gzip(JSON.stringify(world)), as saveWorld stores it',
      )
      write(
        'save/live.json',
        json({ tick: world.tick, version: WORLD_FORMAT_VERSION, savedAs: row ?? null }, 2),
        'the live save’s tick, its format version, and the version its row was saved with',
      )
    } finally {
      rmSync(scratch, { recursive: true, force: true })
    }
  }
  write(
    'save/version.json',
    json({ WORLD_FORMAT_VERSION }, 2),
    'WORLD_FORMAT_VERSION of world-format.ts',
  )
}

function dumpBalance(): void {
  log('balance')
  const constants = Object.fromEntries(
    Object.entries(balance)
      .filter(([, v]) => typeof v !== 'function')
      .sort(([a], [b]) => a.localeCompare(b)),
  )
  write(
    'balance.json',
    json(constants, 2),
    'every exported constant of packages/shared/src/balance.ts',
  )
}

// ---------------------------------------------------------------------------------------------
// README and .gitignore

function filesIn(dir: string, prefix = ''): string[] {
  return readdirSync(dir, { withFileTypes: true })
    .flatMap((e) =>
      e.isDirectory() ? filesIn(join(dir, e.name), `${prefix}${e.name}/`) : [`${prefix}${e.name}`],
    )
    .filter((f) => !['README.md', '.gitignore', '.gitattributes'].includes(f))
    .sort()
}

function writeIndex(): void {
  // Files written before, by an earlier run with other options (`--full`, `--db`), stay listed.
  const readme = join(out, 'README.md')
  const earlier = new Map<string, string>()
  // Those kept out of git stay listed and ignored where they were not made again (`--only`, or a
  // checkout that never had them).
  const missing: string[] = []
  if (existsSync(readme)) {
    for (const m of readFileSync(readme, 'utf8').matchAll(/^\| `([^`]+)` \| (.*) \|$/gm)) {
      earlier.set(m[1]!, m[2]!.replace(/ \(not in git\)$/, ''))
      if (m[2]!.endsWith(' (not in git)') && !existsSync(join(out, m[1]!))) missing.push(m[1]!)
    }
  }
  const files = [...filesIn(out), ...missing].sort()
  const big = files.filter((f) => missing.includes(f) || statSync(join(out, f)).size > GIT_LIMIT)
  writeFileSync(
    join(out, '.gitignore'),
    '# Over about 5 MB: regenerated by scripts/dump-fixtures.mts, kept out of git.\n' +
      big.map((f) => `/${f}\n`).join(''),
  )
  const by = new Map(made.map((m) => [m.path, m.by]))
  const rows = files
    .map((f) => {
      const what = by.get(f) ?? earlier.get(f) ?? 'unknown (not written by this script)'
      return `| \`${f}\` | ${what}${big.includes(f) ? ' (not in git)' : ''} |`
    })
    .join('\n')
  const command = `corepack pnpm exec tsx --conditions=source scripts/dump-fixtures.mts --full --db <path to world.db>`
  writeFileSync(
    readme,
    `# Fixtures from the frozen TypeScript game

Golden files written by \`scripts/dump-fixtures.mts\` from the TypeScript game at the feature
freeze (ADR 0030). Rust tests compare against them: bit for bit for terrain, nodes, random numbers,
hashes and paths, as parsed JSON for worlds. Nothing here is edited by hand; a fixture changes only
when the script runs again. Files over about 5 MB are in \`.gitignore\` and marked "not in git"
below; regenerate them (and everything else) from the repo root with

\`\`\`bash
${command}
\`\`\`

\`--full\` adds the hash of the full-size map, which takes minutes; \`--db\` takes the live save from
a server's database (any worktree's \`apps/server/data/world.db\`; the script works on a copy).
Without them those files are left as they are.

Conventions:

- \`.bin\` files are \`TerrainMap.tiles\`, one byte per tile, row by row (\`y * size + x\`).
- World files are \`{ terrain: { size, tiles: <base64> }, world: <JSON.stringify(world)> }\`, so a
  Rust test needs nothing else.
- \`worlds/*.sight.json\` is \`entitiesInSight\` of that world for every realm and city, by id;
  \`sight/*.json\` are \`{ size, world, sight }\`, the same for the worlds \`sight.test.ts\` starts
  from (sight needs only the map's size).
- Numbers JSON cannot hold are written \`{"$number": "NaN" | "Infinity" | "-Infinity" | "-0"}\`.
- Stepped worlds use a \`Walking\` whose path searches always finish within the tick (budget
  \`Infinity\` instead of \`PATH_BUDGET_MS\`), so where people stand never depends on the machine.
- Path requests run in order, one \`PathFinder\` per walls/roads setting, each kept across its
  requests; \`walls\` is the \`WallMap\` (tiles and the inside they enclose), \`roads\` tile indices.
- Language cases come from the string arguments of the lang tests' helpers (\`value(e)\` runs
  \`out(e)\`), and from \`DEFAULT_SCRIPTS\` (checked, not run: they need the game API). Test cases
  run with only \`out\` and the budget in \`budget\`; \`envs\` holds the checker's names and shapes.
- \`save/live.json.gz\` is a real world loaded the way the server starts (migrated to the current
  format), gzipped as \`saveWorld\` writes it; \`save/live.json\` says which save it was.

| File | Made by |
| --- | --- |
${rows}
`,
  )
}

// ---------------------------------------------------------------------------------------------

async function main(): Promise<void> {
  const o = options(process.argv.slice(2))
  const p = plan(o)
  out = o.out
  mkdirSync(out, { recursive: true })
  const started = performance.now()
  const want = (part: string) => o.only === undefined || o.only.has(part)
  if (want('balance')) dumpBalance()
  if (want('random')) dumpRandom()
  if (want('terrain')) dumpTerrain(p.maps)
  if (want('lang')) dumpLang()
  if (want('paths')) dumpPaths(p.pathMap[0], p.pathMap[1], p.pathCount)
  if (want('save')) await dumpSave(o.db)
  const parts = { worlds: want('worlds'), sight: want('sight') }
  const [villageFrom, hqFrom] = ['village() of npc-growth.fixture.ts', 'hq() of trade-org.test.ts']
  dumpStepped('village', village, villageFrom, p.villageTicks, p.sightTicks, parts)
  dumpStepped('hq', hq, hqFrom, p.hqTicks, p.sightTicks, parts)
  if (want('sight')) dumpSightWorlds()
  if (want('generated')) dumpGenerated(p.generated)
  if (o.full) dumpFullTerrainHash()
  writeIndex()
  log(
    `done in ${((performance.now() - started) / 1000).toFixed(1)} s: ${relative(ROOT, out) || out}`,
  )
}

await main()
