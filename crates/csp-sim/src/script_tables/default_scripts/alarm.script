// Alarm (default): what I do when an alarm reaches me, in place of what I was
// doing, which goes on once I end. Armed, with the town hall occupied, I go
// after the occupier while they stand in the city's area, and end once no armed
// one of theirs is left there or in sight. For a theft I go after the thief, and
// with a wall or neighbour attacked the attacker, until they are dead or have left
// the area or sight. Striking someone occupying the hall, or a thief I know of, is
// no crime in my own city's area, nor is striking back at an attacker; striking
// anyone else is. For an armed outsider in the area I walk to the town hall and
// stand there until no armed outsider is left, which blocks an occupation before
// it starts; an unarmed outsider I only log. A theft, an attack or an occupation
// takes me off the hall, and when I end for it I come back here while armed
// outsiders remain. With a Bow or Crossbow and Arrows I shoot whoever I go
// after from where I stand once they are in my reach; until then I go up on
// the city's wall tile nearest them and wait there rather than come down. Out of
// Arrows I close in as anyone armed. Unarmed, or for another alarm, I end at once.
if (me.alarm == null || !armed(me)) {
  end()
} else if (me.alarm.kind == "occupied") {
  let foe = occupier()
  if (foe == null) {
    end("the occupier is gone")
  } else {
    memory.foeId = foe.id
    goAfter(foe)
  }
} else if (me.alarm.kind == "theft") {
  goAfterCulprit("the thief is gone")
} else if (me.alarm.kind == "attacked") {
  goAfterCulprit("the attacker is gone")
} else if (me.alarm.kind == "outsider") {
  onOutsider()
} else {
  end()
}

// Who came decides whether I go at all; once I do, any armed outsider keeps me.
fn onOutsider() {
  let about = null
  let armedLeft = false
  for (r of outsidersIn(me.alarm.cityId)) {
    if (r.id == me.alarm.about) { about = r }
    if (armed(r)) { armedLeft = true }
  }
  if (memory.holding == null) {
    if (about == null) {
      end()
      return
    }
    if (!armed(about)) {
      log(about.name + " came into the area, unarmed")
      end()
      return
    }
    memory.holding = true
  }
  if (!armedLeft) {
    end("no armed outsider left in the area")
    return
  }
  holdHall()
}

// To the town hall of the alarm's city, and stay there.
fn holdHall() {
  let hall = null
  for (c of cities()) {
    if (c.id == me.alarm.cityId) { hall = building(c.townHallId) }
  }
  if (hall == null) {
    end("no town hall to hold")
    return
  }
  let here = buildingAt(me.x, me.y)
  if (here != null && here.id == hall.id) {
    doing("On alarm: holding the town hall")
    return
  }
  if (me.order != null && me.order.kind == "walkTo") { return } // on my way
  let problem = walkTo(hall.x, hall.y)
  if (problem != null) {
    end("can't reach the town hall: " + problem)
    return
  }
  doing("On alarm: going to hold the town hall")
  log("going to hold " + placeName(hall))
}

fn goAfterCulprit(goneText) {
  let foe = culprit()
  if (foe == null) {
    end(goneText)
  } else {
    goAfter(foe)
  }
}

fn goAfter(foe) {
  if (canShoot() && shootFromWall(foe)) { return }
  let o = me.order
  if (o != null && o.kind == "attack" && o.targetId == foe.id) { return } // at it
  let problem = attack(foe.id)
  if (problem != null) {
    end("can't go after " + foe.name + ": " + problem)
    return
  }
  doing("On alarm: going after " + foe.name)
  log("going after " + foe.name)
}

// An archer shoots from where they stand. On the ground with the city's wall
// between us, I go up on its tile nearest them first, for its cover; up on the
// wall, or with no wall between us, I shoot once they are in my reach and up
// there wait for them rather than come down. False when I can do neither, for me
// to go after them as anyone armed.
fn shootFromWall(foe) {
  let o = me.order
  let post = null
  if (!me.up) {
    // The post I set out for, while they are still in reach of it; else the
    // wall tile between us now.
    post = memory.post
    if (post == null || apart(post, foe) > me.reach) {
      post = wallTileNear(foe)
      memory.post = null
      if (post != null) { memory.post = {x: post.x, y: post.y} }
    }
  }
  if (post == null) {
    if (apart(me, foe) <= me.reach) {
      if (o != null && o.kind == "attack" && o.targetId == foe.id) { return true } // at it
      if (shoot(foe.id) != null) { return false }
      doing("On alarm: shooting at " + foe.name)
      log("shooting at " + foe.name)
      return true
    }
    if (!me.up) { return false }
    // Up on the wall: wait for them to come in reach, rather than go down after them.
    if (o != null) { stop() }
    doing("On alarm: on the wall, waiting for " + foe.name + " to come in reach")
    return true
  }
  if (o != null && o.kind == "walkTo" && o.target.x == post.x && o.target.y == post.y) {
    return true // on my way
  }
  if (walkTo(post.x, post.y) != null) { return false }
  doing("On alarm: up on the wall to shoot at " + foe.name)
  log("going up on the wall to shoot at " + foe.name)
  return true
}

// Whether I shoot: a Bow or Crossbow equipped and Arrows to loose.
fn canShoot() {
  return me.reach != null && me.carried.arrows != null
}

// Tiles between two things as reach counts them: the larger of the two steps.
fn apart(a, b) {
  let dx = a.x - b.x
  let dy = a.y - b.y
  if (dx < 0) { dx = 0 - dx }
  if (dy < 0) { dy = 0 - dy }
  if (dx > dy) { return dx }
  return dy
}

// The first finished wall or gate tile of the alarm's city on the way from the
// foe to me, a step at a time: the one between us, nearest them.
fn wallTileNear(foe) {
  let x = foe.x
  let y = foe.y
  let steps = 0
  while (steps < 64 && (x != me.x || y != me.y)) {
    if (x < me.x) { x = x + 1 }
    if (x > me.x) { x = x - 1 }
    if (y < me.y) { y = y + 1 }
    if (y > me.y) { y = y - 1 }
    let b = buildingAt(x, y)
    if (b != null && b.cityId == me.alarm.cityId && (b.kind == "wall" || b.kind == "gate") && b.site == null) {
      return b
    }
    steps = steps + 1
  }
  return null
}

// The occupier I am after while they stand in the area, else another armed one
// of theirs there.
fn occupier() {
  let after = memory.foeId
  if (after == null) { after = me.alarm.about }
  let realm = me.alarm.realmId
  let other = null
  for (r of residents()) {
    if (r.owner == realm || r.id == after) {
      if (armed(r) && inCityArea(me.alarm.cityId, r.x, r.y)) {
        if (r.id == after) { return r }
        other = r
      }
    }
  }
  return other
}

// Who the alarm is about, while I see them in the city's area.
fn culprit() {
  for (r of residents()) {
    if (r.id == me.alarm.about && inCityArea(me.alarm.cityId, r.x, r.y)) { return r }
  }
  return null
}

// Whether they have a weapon equipped.
fn armed(who) {
  return who.equipped.weapon != null
}

// A building or carriage for my log: "the storage at 12,6".
fn placeName(b) {
  let kind = b.kind
  if (kind == null) { kind = "carriage" }
  return "the " + kind + " at " + b.x + "," + b.y
}

// The units of goods in load for my log: "10 stone, 4 wood".
fn goodsText(load, goods) {
  let text = ""
  for (g of goods) {
    let n = load[g]
    if (n != null && n >= 1) {
      if (text != "") { text = text + ", " }
      text = text + floor(n) + " " + g
    }
  }
  return text
}
