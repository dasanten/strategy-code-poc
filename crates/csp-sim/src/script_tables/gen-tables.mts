// Writes `script_tables.rs` from the frozen TypeScript's script tables (ADR 0030): the script
// views, the game API of residents and armies, the param descriptions and the default scripts'
// names and sources, as Rust data. Run from the repo root:
//   apps/server/node_modules/.bin/tsx --conditions=source crates/csp-sim/src/script_tables/gen-tables.mts crates/csp-sim/src/script_tables.rs
// then `cargo fmt`.
import { writeFileSync } from 'node:fs'
import {
  ARMY_SCRIPT_API,
  PARAM_DESCRIPTIONS,
  SCRIPT_API,
  SCRIPT_PARAM_TYPES,
  type ScriptBinding,
} from '../../../../packages/shared/src/script-api.ts'
import {
  SCRIPT_VIEWS,
  SCRIPT_VIEW_CHANGES,
  type ScriptType,
} from '../../../../packages/shared/src/script-views.ts'
import { DEFAULT_SCRIPTS, TASKS } from '../../../../packages/shared/src/default-scripts.ts'

const str = (s: string) => JSON.stringify(s)
const raw = (s: string) => {
  let hashes = '#'
  while (s.includes('"' + hashes)) hashes += '#'
  return `r${hashes}"${s}"${hashes}`
}
const pascal = (s: string) => s[0]!.toUpperCase() + s.slice(1)
const type = (t: ScriptType): string => {
  if (typeof t === 'string') return `ScriptType::${pascal(t)}`
  if ('view' in t) return `ScriptType::View(${str(t.view)})`
  return `ScriptType::List(&${type(t.list)})`
}

const out: string[] = []
out.push(`//! Generated by \`gen-tables.mts\` from the frozen TypeScript; never edited by hand.
//! The script views (\`script-views.ts\`), the game API (\`script-api.ts\`) and the default scripts'
//! names and sources (\`default-scripts.ts\`).

use crate::script_api::{Is, ScriptBinding};
use crate::script_views::{ScriptField, ScriptType, ScriptView, ViewChange};
use csp_shared::world::Task;
`)

out.push(`/// Every script view by name, in the TypeScript's order (\`SCRIPT_VIEWS\`).
pub static SCRIPT_VIEWS: &[ScriptView] = &[`)
for (const [name, v] of Object.entries(SCRIPT_VIEWS)) {
  out.push(`    ScriptView {
        name: ${str(name)},
        description: ${str(v.description)},
        fields: &[`)
  for (const f of v.fields) {
    out.push(`            ScriptField {
                name: ${str(f.name)},
                r#type: ${type(f.type)},
                description: ${str(f.description)},
                null_when: ${f.nullWhen === undefined ? 'None' : `Some(${str(f.nullWhen)})`},
            },`)
  }
  out.push(`        ],
    },`)
}
out.push(`];
`)

out.push(`/// The breaking changes to the script views so far, oldest first (\`SCRIPT_VIEW_CHANGES\`).
pub static SCRIPT_VIEW_CHANGES: &[ViewChange] = &[`)
for (const c of SCRIPT_VIEW_CHANGES) {
  out.push(
    c.dropped === 'undeclared'
      ? `    ViewChange::Undeclared,`
      : `    ViewChange::Dropped(&[${c.dropped.map(str).join(', ')}]),`,
  )
}
out.push(`];
`)

const bindings = (name: string, doc: string, list: readonly ScriptBinding[]) => {
  out.push(`/// ${doc}
pub static ${name}: &[ScriptBinding] = &[`)
  for (const b of list) {
    out.push(`    ScriptBinding {
        name: ${str(b.name)},
        is: Is::${pascal(b.is)},
        params: &[${b.params.map(str).join(', ')}],
        cost: ${Number.isInteger(b.cost) ? `${b.cost}.0` : b.cost},
        description: ${str(b.description)},
        returns: ${type(b.returns)},
    },`)
  }
  out.push(`];
`)
}
bindings('SCRIPT_API', 'The game API of a resident\'s script (`SCRIPT_API`).', SCRIPT_API)
bindings('ARMY_SCRIPT_API', 'The game API of an army\'s script (`ARMY_SCRIPT_API`).', ARMY_SCRIPT_API)

out.push(`/// What each param type accepts, for the Wiki and the editor (\`PARAM_DESCRIPTIONS\`), in the
/// order of \`SCRIPT_PARAM_TYPES\`.
pub static PARAM_DESCRIPTIONS: &[(&str, &str)] = &[`)
for (const t of SCRIPT_PARAM_TYPES) out.push(`    (${str(t)}, ${str(PARAM_DESCRIPTIONS[t])}),`)
out.push(`];
`)

out.push(`/// Each task's default script: its name as the UI shows it, and its source
/// (\`DEFAULT_SCRIPTS\`), in the order of \`TASKS\`.
pub static DEFAULT_SCRIPTS: &[(Task, &str, &str)] = &[`)
for (const t of TASKS) {
  const d = DEFAULT_SCRIPTS[t]
  out.push(`    (
        Task::${pascal(t)},
        ${str(d.name)},
        ${raw(d.source)},
    ),`)
}
out.push(`];`)

writeFileSync(process.argv[2]!, out.join('\n') + '\n')
