# Copy to `.env` in the deploy directory on the server. Read by compose and the game server.

# The (sub)domain pointing at this server; Caddy gets its certificate.
DOMAIN=game.example.com

LOG_LEVEL=info
# Sentry (ADR 0004). Empty turns reporting off.
SENTRY_DSN=

# Browsers the game's WebSocket accepts, besides https://$DOMAIN itself (the request's own host
# as Caddy forwards it): comma-separated origins, only needed when the game is also opened from
# another host. Unset: the game's own origin only.
# ALLOWED_ORIGINS=https://other.example.com
