{
  "name": "code-strategy-poc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @csp/web build",
    "typecheck": "node scripts/wasm-build.mjs && tsc -b && pnpm --filter @csp/lang-wasm typecheck && pnpm --filter @csp/web typecheck && pnpm --filter @csp/balance typecheck",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "cargo run -p csp-server --bin csp-server",
    "dev:web": "pnpm --filter @csp/web dev",
    "start": "cargo run --release -p csp-server --bin csp-server",
    "test": "node scripts/wasm-build.mjs && vitest run",
    "check": "eslint . --cache --cache-location node_modules/.cache/eslint/ && pnpm typecheck && node scripts/check-tests.mjs",
    "types:rust": "cargo run -q -p csp-server --bin export-types",
    "balance:rust": "cargo run -q -p csp-shared --bin write-balance",
    "wasm:build": "node scripts/wasm-build.mjs",
    "script-data:rust": "cargo run --quiet --package csp-lang-wasm --bin script-data",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo nextest run --workspace",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
