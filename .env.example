# Copy to .env (git-ignored). Read by the server and by Vite for the client.

# Server
PORT=3000
HOST=127.0.0.1
# DB_PATH=data/world.db
# Where daily and pre-migration backups go. Unset: no backups (the default in dev).
# BACKUP_DIR=data/backups
# trace | debug | info | warn | error
LOG_LEVEL=info
# Share of ticks whose invariants are checked. Default: 1 in dev, 0.1 when NODE_ENV=production.
# INVARIANT_SAMPLE_RATE=1

# Sentry (ADR 0004). Leave empty to turn reporting off; logs are still written.
SENTRY_DSN=
# Browser DSN, baked into the client bundle at build time.
VITE_SENTRY_DSN=
